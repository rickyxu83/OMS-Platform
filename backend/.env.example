PORT=3000
HOST=127.0.0.1
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oms_platform
DB_CONNECTION_LIMIT=10

UPLOAD_DIR=uploads

SESSION_COOKIE_NAME=oms_platform_token
SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MR 签核人允许使用的邮箱域名，逗号分隔；留空时只检查邮箱格式
MR_APPROVAL_EMAIL_DOMAINS=

# AI 工作内容总结（后端调用，可接 OpenAI-compatible 或自定义兼容接口）
AI_WORK_SUMMARY_ENABLED=false
AI_PROVIDER=custom
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_INPUT_ITEMS=200
AI_MAX_WORK_CONTENT_CHARS=600
AI_SUMMARY_TIMEOUT_MS=30000
# 报价文件 AI 识别（MR 报价导入）
AI_QUOTE_RECOGNITION_ENABLED=false
AI_QUOTE_TIMEOUT_MS=90000
# 识别温度：留空则不下发该参数（kimi-for-coding 仅允许默认 0.6，显式传其他值会报错）
AI_QUOTE_TEMPERATURE=
