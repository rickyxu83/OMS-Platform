# Copy this file to scripts/deploy.local.env and fill in private values locally.
# scripts/deploy.local.env is ignored by git.

# Default deployment environment
DEPLOY_SSH_TARGET=
DEPLOY_REMOTE_ROOT=
DEPLOY_BACKEND_RELATIVE=app/backend
DEPLOY_SITE_RELATIVE=app/site
DEPLOY_BACKEND_CONTAINER=
DEPLOY_PROJECT_SLUG=oms-platform
DEPLOY_VITE_API_BASE_URL=
DEPLOY_VITE_UNIFIED_LOGIN_URL=
DEPLOY_VITE_ENGINEER_WORKSPACE_URL=
DEPLOY_VITE_ADMIN_HOST_PREFIX=admin.
DEPLOY_VITE_ENGINEER_HOST_PREFIX=eng.

